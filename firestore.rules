rules_version = '2';service cloud.firestore{match /databases/{database}/documents{match /reviews/{id}{allow read:true;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow update,delete:if request.auth!=null&&resource.data.uid==request.auth.uid;}match /supportTickets/{id}{allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow read,update,delete:false;}}}